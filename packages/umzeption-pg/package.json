{
  "name": "umzeption-pg",
  "version": "0.0.0",
  "description": "PostgreSQL context and storage for umzeption",
  "homepage": "http://github.com/voxpelli/umzeption",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/umzeption.git",
    "directory": "packages/umzeption-pg"
  },
  "keywords": [
    "umzug",
    "umzeption",
    "migration",
    "database",
    "postgres",
    "postgresql"
  ],
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "typescript": ">=5.8"
  },
  "type": "module",
  "exports": "./index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "build": "run-s build:*",
    "check:installed-check": "installed-check",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 99 --ignore-files 'test/*'",
    "check": "run-s clean && run-p check:* --continue-on-error",
    "clean": "node ../../scripts/clean-declarations.js",
    "prepublishOnly": "run-s build",
    "test:node": "c8 --reporter=lcov --reporter text node --test",
    "test-ci": "run-s test:*",
    "test": "run-s check test:*"
  },
  "peerDependencies": {
    "umzeption": "^1.0.0",
    "umzug": "^3.8.1"
  },
  "dependencies": {
    "pg": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/pg": "^8.11.10",
    "@types/sinon": "^17.0.3",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.1.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "installed-check": "^10.0.1",
    "knip": "^5.86.0",
    "npm-run-all2": "^8.0.4",
    "sinon": "^19.0.2",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3",
    "umzeption": "*",
    "umzug": "^3.8.2"
  }
}
