{
  "name": "umzeption",
  "version": "1.0.0",
  "description": "A recursive umzug extension",
  "homepage": "http://github.com/voxpelli/umzeption",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/umzeption.git",
    "directory": "packages/umzeption"
  },
  "keywords": [
    "umzug",
    "migration",
    "database"
  ],
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "typescript": ">=5.9"
  },
  "type": "module",
  "exports": "./index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "build": "run-s build:*",
    "check-type-tests": "run-s build && tstyche --target \"$(node -p \"require('./package.json').engines.typescript\")\" --reporters list,summary && run-s clean",
    "check:installed-check": "installed-check -i tstyche",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 99 --ignore-files 'test/*'",
    "check": "run-s clean && run-p check:* --continue-on-error && run-s check-type-tests",
    "clean": "node ../../scripts/clean-declarations.js",
    "prepublishOnly": "run-s build",
    "test:node": "c8 --reporter=lcov --reporter text node --test",
    "test-ci": "run-s test:*",
    "test": "run-s check test:*"
  },
  "peerDependencies": {
    "umzug": "^3.8.1"
  },
  "dependencies": {
    "@voxpelli/type-helpers": "^4.1.0",
    "@voxpelli/typed-utils": "^4.2.0",
    "plugin-importer": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/sinon": "^17.0.3",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.2.1",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "installed-check": "^10.0.1",
    "knip": "^5.86.0",
    "npm-run-all2": "^8.0.4",
    "sinon": "^19.0.2",
    "tstyche": "^6.2.0",
    "type-coverage": "^2.29.7",
    "typescript": "~6.0.0",
    "umzug": "^3.8.2",
    "validate-conventional-commit": "^1.0.4"
  }
}
